# UltraMAX server-side API defaults. User-supplied keys take precedence.
TMDB_KEY=your_tmdb_api_key_here
MDBLIST_KEYS=your_mdblist_api_key_here
TRAKT_CLIENT_ID=your_trakt_client_id_here
TVDB_API_KEY=
FANART_KEY=
OMDB_KEY=
GOOGLE_AI_KEY=
RPDB_KEY=
TP_KEY=

# Canonical AIOStreams baseline
AIOSTREAMS_TEMPLATE_URL=https://templates.peden88.stream/complete.json
AIOSTREAMS_TEMPLATE_ID=tamtaro.complete
AIOSTREAMS_TEMPLATE_CACHE_MS=900000

# Internal provider URLs may be private Docker-network addresses.
AIOSTREAMS_BASE_URL=http://aiostreams:3000
AIOMETADATA_BASE_URL=http://aiometadata:3000

# Required production secrets
ULTRAMAX_ENCRYPTION_KEY=
ULTRAMAX_SERVICES_MASTER_KEY=
AIOMETADATA_ADDON_PASSWORD=
